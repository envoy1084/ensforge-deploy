# Optional RPC endpoints used by embedded read-action demos.
VITE_ENSFORGE_MAINNET_RPC_URL=
VITE_ENSFORGE_SEPOLIA_RPC_URL=

# Optional GraphQL endpoint overrides used by embedded indexer demos.
ENSFORGE_MAINNET_V1_INDEXER_URL=
ENSFORGE_SEPOLIA_V1_INDEXER_URL=
ENSFORGE_SEPOLIA_V2_INDEXER_URL=

# Recommended for the navbar RainbowKit connection modal.
VITE_WALLETCONNECT_PROJECT_ID=

# Production browser analytics. Leave the key empty to disable. Never use a personal API key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://t.envoy1084.xyz
